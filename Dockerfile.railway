# ── 백엔드 배포용 Dockerfile ──────────────────────────────────────────────────
# 빌드 컨텍스트: 리포지토리 루트 (모노레포 전체)
#   Railway  : Dockerfile Path = Dockerfile.railway
#   compose  : docker compose up --build  (docker-compose.yml 참조)
#
# ★ Playwright 버전 결합 ★
#   아래 베이스 이미지 태그와 apps/backend/package.json 의 "playwright" 버전은
#   **정확히 같아야 한다.** 이미지에 동봉된 Chromium 과 시스템 라이브러리가
#   해당 Playwright 버전에 맞춰져 있기 때문이다.
#   과거 이미지는 v1.44.0 에 고정돼 있었는데 package.json 은 캐럿(^1.44.0)이라
#   실제로는 1.59.1 이 설치되어 두 버전이 1년 넘게 벌어져 있었다.
#   playwright 를 올릴 때는 이 태그도 함께 올릴 것.

# ── 1단계: 빌드 ──────────────────────────────────────────────────────────────
FROM node:20-slim AS builder

WORKDIR /app

# 모노레포 루트 + 워크스페이스 매니페스트 (레이어 캐시를 위해 소스보다 먼저)
COPY package*.json ./
COPY packages/shared/package*.json ./packages/shared/
COPY apps/backend/package*.json ./apps/backend/

RUN npm ci --workspace=packages/shared --workspace=apps/backend --include-workspace-root

# 소스 복사
COPY packages/ ./packages/
COPY apps/backend/ ./apps/backend/

# shared → backend 순서로 빌드
RUN npm run build --workspace=packages/shared
RUN npm run build --workspace=apps/backend

# ── 2단계: 런타임 ─────────────────────────────────────────────────────────────
# Playwright 공식 이미지 — Chromium + 시스템 의존성이 이미 들어 있어
# `npx playwright install` 이 필요 없다 (위 "Playwright 버전 결합" 참고).
FROM mcr.microsoft.com/playwright:v1.59.1-jammy

WORKDIR /app

ENV NODE_ENV=production
# 수집 파일 저장 위치. 재시작 시 유실되지 않도록 **영속 볼륨을 이 경로에 마운트**할 것.
#   compose : ./apps/backend/uploads:/app/uploads
#   AWS ECS : EFS 또는 EBS 볼륨
# 볼륨이 없으면 컨테이너 재시작 후 다음 수집 전까지 대시보드 값이 비게 된다.
ENV UPLOAD_DIR=/app/uploads

# 프로덕션 의존성만 설치
COPY package*.json ./
COPY packages/shared/package*.json ./packages/shared/
COPY apps/backend/package*.json ./apps/backend/

RUN npm ci --omit=dev --workspace=packages/shared --workspace=apps/backend --include-workspace-root

# 빌드 결과물 복사
COPY --from=builder /app/apps/backend/dist    ./apps/backend/dist
COPY --from=builder /app/packages/shared/dist ./packages/shared/dist

RUN mkdir -p /app/uploads /app/outputs

EXPOSE 4000

CMD ["node", "apps/backend/dist/index.js"]
